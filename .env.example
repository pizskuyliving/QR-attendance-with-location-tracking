APP_NAME="FLEX"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
# true bila diakses lewat HTTPS (tunnel/hosting) agar semua tautan memakai https
FORCE_HTTPS=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email kode verifikasi. "log" = tidak dikirim (hanya ke storage/logs), untuk uji coba saja.
# Gmail: aktifkan Verifikasi 2 Langkah, buat Sandi Aplikasi di myaccount.google.com/apppasswords,
# lalu MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME & MAIL_FROM_ADDRESS = alamat Gmail,
# MAIL_PASSWORD = sandi aplikasi 16 huruf tanpa spasi. Uji: php artisan flex:tes-email alamat@kamu.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Captcha Cloudflare Turnstile. Key gratis: dash.cloudflare.com > Turnstile > Add widget (lihat README)
# Kosong + APP_ENV=local = key uji (selalu lolos). Di production wajib diisi.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email yang boleh dipakai mahasiswa saat daftar (format UIR: nama@student.uir.ac.id).
# Lebih dari satu: pisahkan dengan koma. Kosongkan untuk menerima semua email.
DOMAIN_EMAIL_MAHASISWA=student.uir.ac.id

# Batas ukuran file materi/tugas (KB). Samakan dengan upload_max_filesize di php.ini.
MAKS_UNGGAH_KB=20480

# Nama kampus di footer
NAMA_INSTITUSI="Universitas Islam Riau"
